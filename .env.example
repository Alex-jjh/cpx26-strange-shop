# Server-side only (set in Vercel project settings, never in the frontend):
LLM_API_KEY=
LLM_BASE_URL=https://aihubmix.com/v1
LLM_MODEL=gpt-4o-mini
# Extra CORS origins besides the Capacitor app (comma-separated), e.g. preview URLs:
ALLOWED_ORIGINS=

# Frontend, only for the APK build: the deployed site, e.g. https://xxx.vercel.app
VITE_API_BASE=
